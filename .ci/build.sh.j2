{% extends "ci-infrastructure/cmake-all-lanes.sh.j2" %}
{% block set_environment %}
{% if c_flags | default("") %}
export CFLAGS={{ c_flags | sh }}
{% endif %}
{% if cxx_flags | default("") %}
export CXXFLAGS={{ cxx_flags | sh }}
{% endif %}
{% if fortran_flags | default("") %}
export FFLAGS={{ fortran_flags | sh }}
{% endif %}
{% endblock %}
